# Copy to .env and adjust. Defaults match docker-compose.yml.

# SQLAlchemy URL for MySQL using the PyMySQL driver
MYSQL_URL=mysql+pymysql://energy:energy@localhost:3306/energy

MONGO_URL=mongodb://localhost:27017
MONGO_DB=energy

# Base URL of the FastAPI app, used by scripts/predict.py
API_BASE_URL=http://127.0.0.1:8000